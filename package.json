{
  "name": "parakeet-studio",
  "productName": "Parakeet Studio",
  "version": "0.8.1",
  "description": "Independent Windows interview copilot reconstruction",
  "author": "Rohit and contributors",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "prestart": "npm run build:native",
    "pretest:desktop": "npm run build:native",
    "pretest:hardening": "npm run build:native",
    "pretest:soak": "npm run build:native",
    "pretest:hardware": "npm run build:native",
    "pretest:live": "npm run build:native",
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/core.test.cjs tests/audio.test.mjs tests/reliability.test.cjs tests/resume.test.cjs tests/safety.test.cjs tests/question-queue.test.mjs tests/desktop-runtime.test.cjs tests/audio-timing.test.cjs tests/production.test.cjs tests/eval.test.cjs tests/install-lifecycle.test.cjs tests/realtime.test.cjs tests/benchmark.test.cjs tests/desktop-live.test.cjs",
    "test:desktop": "node scripts/verify-desktop.cjs",
    "build:win": "npm run build:native && npm run build:icon && electron-builder --win portable nsis --x64 --publish never",
    "build:dir": "npm run build:native && npm run build:icon && electron-builder --win --x64 --dir --publish never",
    "release:source": "node scripts/release-source.cjs",
    "test:live": "node scripts/verify-live.cjs",
    "test:hardening": "node scripts/verify-hardening.cjs",
    "test:soak": "node scripts/verify-soak.cjs",
    "test:hardware": "node scripts/verify-soak.cjs --hardware",
    "test:ui": "node scripts/verify-ui.cjs",
    "test:production": "node scripts/verify-production.cjs",
    "pretest:production": "npm run build:native",
    "build:signed": "npm run build:native && npm run build:icon && node scripts/build-signed.cjs",
    "release:inventory": "node scripts/dependency-inventory.cjs",
    "test:eval": "node --test tests/eval.test.cjs tests/benchmark.test.cjs",
    "test:eval-sandbox": "node scripts/verify-eval-sandbox.cjs",
    "eval:prepare": "node scripts/prepare-eval.cjs",
    "eval:run": "node scripts/evaluate.cjs",
    "eval:desktop": "node scripts/evaluate-desktop.cjs",
    "test:devices": "node scripts/verify-devices.cjs",
    "pretest:devices": "npm run build:native",
    "build:icon": "node scripts/build-icon.cjs",
    "test:latency": "node scripts/verify-latency.cjs",
    "eval:record": "node scripts/record-human-audio.cjs",
    "eval:quality": "node scripts/benchmark-quality.cjs",
    "test:install-lifecycle": "node scripts/verify-install-lifecycle.cjs",
    "test:accessibility:prepare": "node scripts/prepare-accessibility.cjs",
    "test:realtime": "node --test tests/realtime.test.cjs",
    "test:realtime:desktop": "npm run build:native && node scripts/verify-realtime.cjs",
    "eval:report": "node scripts/report-quality.cjs",
    "test:eval-pipeline": "node scripts/verify-quality-pipeline.cjs",
    "eval:desktop-live": "node scripts/benchmark-desktop-live.cjs"
  },
  "dependencies": {
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.61.1",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "local.parakeetstudio.desktop",
    "productName": "Parakeet Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "native/TimerPolicy.exe",
        "to": "TimerPolicy.exe"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Parakeet-Studio-${version}-portable.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": true
    },
    "nsis": {
      "artifactName": "Parakeet-Studio-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  }
}
